#!/bin/sh /etc/rc.common

USE_PROCD=1
START=55
STOP=15

start_service() {
	# OpenWrt keeps /var on tmpfs. Preserve the systemd StateDirectory
	# semantics by backing the upstream /var/lib path with persistent storage.
	mkdir -p /etc/m2172-modem/efs /var/lib
	[ -e /var/lib/m2172-modem ] || \
		ln -s /etc/m2172-modem /var/lib/m2172-modem

	procd_open_instance
	procd_set_param command /usr/local/sbin/m2172-modem-bringup.sh
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
