#!/bin/sh

. /usr/share/ModemManager/modemmanager.common

trap_with_arg() {
	func="$1"; shift
	for sig; do
		# shellcheck disable=SC2064
		trap "$func $sig" "$sig"
	done
}

func_trap() {
	logger "ModemManager-wrapper[$$]" "Sending signal ${1}..."
	[ -z "$REPORTER" ] || kill "-${1}" "$REPORTER" 2>/dev/null
	[ -z "$CHILD" ] || kill "-${1}" "$CHILD" 2>/dev/null
}

stop_reporter() {
	[ -n "$REPORTER" ] || return
	kill "$REPORTER" 2>/dev/null
	wait "$REPORTER" 2>/dev/null
	REPORTER=
}

main() {
	local status

	trap_with_arg func_trap INT TERM

	mkdir -p "${MODEMMANAGER_RUNDIR}"
	chmod 0755 "${MODEMMANAGER_RUNDIR}"

	/usr/sbin/ModemManager "$@" 1>/dev/null 2>/dev/null &
	CHILD="$!"

	# Replay cached kernel events concurrently.  If ModemManager cannot start
	# (for example while an old process is still releasing its D-Bus name),
	# the wrapper must exit immediately so procd can respawn it instead of
	# blocking in the event replay loop for up to one minute.
	mm_report_events_from_cache &
	REPORTER="$!"

	wait "$CHILD"
	status="$?"
	stop_reporter
	exit "$status"
}

main "$@"
