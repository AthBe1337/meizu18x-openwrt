CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_m2172=y
CONFIG_TARGET_armsr_m2172_DEVICE_meizu_m2172=y
CONFIG_DEVEL=y
CONFIG_KERNEL_GIT_CLONE_URI="https://github.com/meizu-m2172-mainline/linux.git"
CONFIG_KERNEL_GIT_REF="8afab201fb9812de7da2144e68e53f08394a8a1b"
CONFIG_KERNEL_GIT_MIRROR_HASH="1d03f1298e68412261cf39170a8fa8f8bb1daaff9cbb734a66f690fb8f76bfbc"
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_PARTSIZE=9216
# CONFIG_TARGET_IMAGES_GZIP is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set

CONFIG_PACKAGE_m2172-firmware=y
CONFIG_PACKAGE_m2172-initrd=y
CONFIG_PACKAGE_m2172-kernel-modules=y
CONFIG_PACKAGE_m2172-mark-boot-successful=y
CONFIG_PACKAGE_m2172-modem-userspace=y
CONFIG_PACKAGE_kmod=y
CONFIG_PACKAGE_tqftpserv=y
CONFIG_PACKAGE_libqrtr=y
CONFIG_PACKAGE_qrtr-tools=y

CONFIG_PACKAGE_modemmanager=y
CONFIG_MODEMMANAGER_WITH_NETIFD=y
# CONFIG_MODEMMANAGER_WITH_MBIM is not set
CONFIG_MODEMMANAGER_WITH_QMI=y
CONFIG_MODEMMANAGER_WITH_QRTR=y
# CONFIG_MODEMMANAGER_WITH_AT_COMMAND_VIA_DBUS is not set
CONFIG_PACKAGE_libqmi=y
CONFIG_PACKAGE_qmi-utils=y
# CONFIG_LIBQMI_WITH_MBIM_QMUX is not set
CONFIG_LIBQMI_WITH_QRTR_GLIB=y
CONFIG_LIBQMI_COLLECTION_FULL=y

CONFIG_PACKAGE_python3-light=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_procps-ng-ps=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-realpath=y
CONFIG_PACKAGE_coreutils-stat=y

# Complete LuCI collection with HTTPS, Simplified Chinese and modem support.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-proto-modemmanager=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_px5g-mbedtls=y

# PassWall client with firewall4/nftables transparent proxying.  Keep both
# current general-purpose cores and the common compatibility clients so node
# subscriptions can be imported without installing extra packages later.
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
CONFIG_SING_BOX_BUILD_ACME=y
CONFIG_SING_BOX_BUILD_CLASH_API=y
CONFIG_SING_BOX_BUILD_GVISOR=y
CONFIG_SING_BOX_BUILD_QUIC=y
CONFIG_SING_BOX_BUILD_TAILSCALE=y
CONFIG_SING_BOX_BUILD_UTLS=y
CONFIG_SING_BOX_BUILD_WIREGUARD=y

# Docker Engine and its LuCI manager.  Enable the useful local ext4, overlay
# network and macvlan paths; encrypted Swarm networking remains optional.
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_DOCKER_STO_EXT4=y
CONFIG_DOCKER_NET_OVERLAY=y
CONFIG_DOCKER_NET_MACVLAN=y
# CONFIG_DOCKER_NET_ENCRYPT is not set
# CONFIG_DOCKER_NET_TFTP is not set
# CONFIG_DOCKER_STO_DEVMAPPER is not set
# CONFIG_DOCKER_STO_BTRFS is not set
# CONFIG_DOCKER_CHECK_CONFIG is not set
# CONFIG_DOCKER_CGROUP_OPTIONS is not set
# CONFIG_DOCKER_OPTIONAL_FEATURES is not set

# Cellular WAN sharing over a Wi-Fi access point.  Kernel functionality comes
# from m2172-kernel-modules; OpenWrt kmod packages are dependency markers only.
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_WIFI_SCRIPTS_UCODE=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y

# Pure userspace administration, transfer and diagnostic tools.  These are
# useful on the phone without requiring any OpenWrt kernel module packages.
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_file=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_zoneinfo-asia=y

# The rootfs is booted by the pinned Linux 7.1.0 kernel.  The selections
# below prevent unrelated armsr hardware drivers from entering the image.
